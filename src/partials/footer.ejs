</main>
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="brand brand-light" href="index.html">
        <img src="assets/img/logo.svg" alt="" width="36" height="36">
        <span class="brand-text"><strong><%= site.company.name %></strong><small>Technology Solutions</small></span>
      </a>
      <p><%= site.company.tagline %></p>
      <p class="footer-address"><%= site.company.address %></p>
    </div>
    <div>
      <h2>Solutions</h2>
      <ul>
        <% site.solutions.forEach(function (s) { %>
        <li><a href="solutions.html#<%= s.id %>"><%= s.name %></a></li>
        <% }) %>
      </ul>
    </div>
    <div>
      <h2>Company</h2>
      <ul>
        <% site.nav.forEach(function (item) { %>
        <li><a href="<%= item.href %>"><%= item.label %></a></li>
        <% }) %>
      </ul>
    </div>
    <div>
      <h2>Contact</h2>
      <ul>
        <li><a href="mailto:<%= site.company.email %>"><%= site.company.email %></a></li>
        <li><a href="mailto:<%= site.company.serviceDesk %>">24/7 service desk</a></li>
        <li><a href="contact.html">Contact form</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-note">
    <span>&copy; <span id="year"><%= buildDate.slice(0, 4) %></span> <%= site.company.legalName %> Contoso is a fictional company used for GitHub workshops.</span>
    <span>Built <%= buildDate %> &middot; Deployed with GitHub Actions to GitHub Pages</span>
  </div>
</footer>
<script src="assets/js/site.js" defer></script>
<% (locals.scripts || []).forEach(function (src) { %>
<script src="<%= src %>" defer></script>
<% }) %>
</body>
</html>
