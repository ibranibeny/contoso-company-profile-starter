<%- include('../partials/head', { title: 'News', description: 'News and announcements from ' + site.company.name }) %>
<%- include('../partials/header') %>
<section class="page-hero">
  <div class="container">
    <p class="eyebrow">Newsroom</p>
    <h1>News and announcements</h1>
    <p>Company updates, client stories and what our teams are learning.</p>
  </div>
</section>

<section class="section">
  <div class="container narrow">
    <form class="search" role="search" action="news.html" method="get">
      <label for="q">Search the newsroom</label>
      <input id="q" name="q" type="search" placeholder="Try: security, AI, graduate">
      <button class="btn btn-dark" type="submit">Search</button>
    </form>
    <p id="search-summary" class="search-summary" aria-live="polite"></p>
    <div class="news-list">
      <% news.forEach(function (item) { %>
      <article class="news-item" data-news-item>
        <span class="tag"><%= item.tag %></span>
        <h2><%= item.title %></h2>
        <p><%= item.summary %></p>
        <time datetime="<%= item.date %>"><%= item.date %></time>
      </article>
      <% }) %>
    </div>
  </div>
</section>
<%- include('../partials/footer', { scripts: ['assets/js/news-search.js'] }) %>
