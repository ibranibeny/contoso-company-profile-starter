<%- include('../partials/head', { title: 'Services', description: 'Cloud, data and AI, cybersecurity, digital products and managed services from ' + site.company.name }) %>
<%- include('../partials/header') %>
<section class="page-hero">
  <div class="container">
    <p class="eyebrow">Services</p>
    <h1>Everything it takes to build and run digital services</h1>
    <p>Five practices, one delivery model and a single team that stays accountable after go-live.</p>
  </div>
</section>

<section class="section">
  <div class="container card-grid card-grid-wide">
    <% site.services.forEach(function (svc) { %>
    <article class="card">
      <span class="card-icon"><%- include('../partials/icon', { name: svc.icon }) %></span>
      <h2><%= svc.name %></h2>
      <p><%= svc.summary %></p>
      <ul>
        <% svc.capabilities.forEach(function (cap) { %>
        <li><%= cap %></li>
        <% }) %>
      </ul>
    </article>
    <% }) %>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">How we work</p>
      <h2>Our engagement model</h2>
      <p>Short feedback loops, automated quality and security gates, and no surprises.</p>
    </div>
    <ol class="steps">
      <% site.engagement.forEach(function (step) { %>
      <li><h3><%= step.name %></h3><p><%= step.text %></p></li>
      <% }) %>
    </ol>
  </div>
</section>

<section class="cta-band">
  <div class="container">
    <div>
      <h2>Not sure where to start?</h2>
      <p>Book a free discovery workshop with our architects.</p>
    </div>
    <a class="btn btn-dark" href="contact.html">Book a workshop</a>
  </div>
</section>
<%- include('../partials/footer') %>
