<%- include('../partials/head', { title: 'Contact', description: 'Contact ' + site.company.legalName }) %>
<%- include('../partials/header') %>
<section class="page-hero">
  <div class="container">
    <p class="eyebrow">Contact</p>
    <h1>Let's talk about what you are building</h1>
    <p>Send us a note and a specialist will reply within two business days.</p>
  </div>
</section>

<section class="section">
  <div class="container split">
    <form id="contact-form" class="card form-grid" novalidate>
      <div class="field">
        <label for="name">Full name</label>
        <input id="name" name="name" autocomplete="name" required>
      </div>
      <div class="field">
        <label for="email">Work email</label>
        <input id="email" name="email" type="email" autocomplete="email" required>
      </div>
      <div class="field">
        <label for="company">Company</label>
        <input id="company" name="company" autocomplete="organization">
      </div>
      <div class="field">
        <label for="topic">Topic</label>
        <select id="topic" name="topic" required>
          <option value="">Choose a topic</option>
          <% site.topics.forEach(function (topic) { %>
          <option><%= topic %></option>
          <% }) %>
        </select>
      </div>
      <div class="field full">
        <label for="message">How can we help?</label>
        <textarea id="message" name="message" rows="5" required minlength="20"></textarea>
      </div>
      <label class="checkbox full"><input type="checkbox" name="consent" required> I agree that Contoso may contact me about this request.</label>
      <div class="full">
        <button class="btn btn-dark" type="submit">Send message</button>
        <p id="form-status" class="form-status" role="status"></p>
      </div>
    </form>
    <div>
      <div class="section-head">
        <p class="eyebrow">Offices</p>
        <h2>Visit us</h2>
      </div>
      <% site.offices.forEach(function (office) { %>
      <article class="card office">
        <h3><%= office.city %> <span class="tag"><%= office.type %></span></h3>
        <p><%= office.address %></p>
      </article>
      <% }) %>
      <p>Email: <a href="mailto:<%= site.company.email %>"><%= site.company.email %></a></p>
    </div>
  </div>
</section>
<%- include('../partials/footer', { scripts: ['assets/js/contact.js'] }) %>
